// Golden fixture: byte-identical to emu/examples/mandelbrot.rs
//
// 32x16 ASCII Mandelbrot in Q12.4 fixed-point. 46 instruction words.
// '#' for points still bounded after 16 iterations, ' ' otherwise.
//
// Register map:
//   r0  = cx (Q12.4)        r5  = x²       r10 = scratch (xy / 2xy)
//   r1  = cy (Q12.4)        r6  = y²
//   r2  = x  (Q12.4)        r7  = col counter
//   r3  = y  (Q12.4)        r8  = row counter
//   r4  = iter

.equ STDOUT_CHAR 0xFF00
.equ HALT        0xFFFE

// Q12.4 fixed-point constants (raw 16-bit, real * 16):
.equ CX_INIT  -36       // -2.25
.equ CY_INIT  -16       // -1.0
.equ STEP      2        // +0.125 per row/col
.equ COLS     32
.equ ROWS     16

.equ MAX_ITER  16
.equ ESCAPE_SHR 6       // (sum >> 6) != 0  →  escaped

init:
  // word 0: r8 = 0 (row); r1 = -16 (cy_init)
  #0 -> r8; #CY_INIT -> r1

row:
  // word 1: r7 = 0 (col); r0 = -36 (cx_init)
  #0 -> r7; #CX_INIT -> r0

col:
  // word 2: r2 = 0 (x); r3 = 0 (y); r4 = 0 (iter)
  #0 -> r2; #0 -> r3; #0 -> r4

inner:
  // word 3: iter >= 16 ?
  r4 -> ALU_A; #MAX_ITER -> ALU_GE_T
  // word 4: capture predicate
  ALU_P -> p0
  // word 5: [p0] jump in_set
  [p0] #in_set -> GCU_JMP_T
  // word 6: trigger x*x
  r2 -> MUL_A; r2 -> MUL_T
  // word 7: ALU shifts x*x>>4 (=x²); MUL fires y*y in parallel
  MUL_R -> ALU_A; #4 -> ALU_SSHR_T; r3 -> MUL_A; r3 -> MUL_T
  // word 8: capture x²; ALU shifts y*y>>4 (=y²)
  ALU_R -> r5; MUL_R -> ALU_A; #4 -> ALU_SSHR_T
  // word 9: capture y²
  ALU_R -> r6
  // word 10: sum = x² + y²
  r5 -> ALU_A; r6 -> ALU_ADD_T
  // word 11: sum >> 6 (logical)
  ALU_R -> ALU_A; #ESCAPE_SHR -> ALU_SHR_T
  // word 12: (sum >> 6) != 0 ?
  ALU_R -> ALU_A; #0 -> ALU_NE_T
  // word 13: capture predicate
  ALU_P -> p0
  // word 14: [p0] jump escaped
  [p0] #escaped -> GCU_JMP_T
  // word 15: trigger x*y
  r2 -> MUL_A; r3 -> MUL_T
  // word 16: xy = (x*y) >> 4
  MUL_R -> ALU_A; #4 -> ALU_SSHR_T
  // word 17: capture xy
  ALU_R -> r10
  // word 18: 2*xy = xy << 1
  r10 -> ALU_A; #1 -> ALU_SHL_T
  // word 19: capture 2xy into r10; trigger x²-y²
  ALU_R -> r10; r5 -> ALU_A; r6 -> ALU_SUB_T
  // word 20: (x²-y²) + cx
  ALU_R -> ALU_A; r0 -> ALU_ADD_T
  // word 21: capture new_x; trigger 2xy + cy
  ALU_R -> r2; r10 -> ALU_A; r1 -> ALU_ADD_T
  // word 22: capture new_y
  ALU_R -> r3
  // word 23: iter++
  r4 -> ALU_A; #1 -> ALU_ADD_T
  // word 24: capture iter; jump inner
  ALU_R -> r4; #inner -> GCU_JMP_T

in_set:
  // word 25: print '#'
  #STDOUT_CHAR -> LSU_ST_A; #'#' -> LSU_ST_T
  // word 26: jump inc_col
  #inc_col -> GCU_JMP_T

escaped:
  // word 27: print ' '
  #STDOUT_CHAR -> LSU_ST_A; #' ' -> LSU_ST_T
  // word 28: jump inc_col
  #inc_col -> GCU_JMP_T

inc_col:
  // word 29: cx += 0.125 (raw +2)
  r0 -> ALU_A; #STEP -> ALU_ADD_T
  // word 30: capture cx
  ALU_R -> r0
  // word 31: col++
  r7 -> ALU_A; #1 -> ALU_ADD_T
  // word 32: capture col
  ALU_R -> r7
  // word 33: col < 32 ?
  r7 -> ALU_A; #COLS -> ALU_LT_T
  // word 34: capture predicate
  ALU_P -> p0
  // word 35: [p0] jump col
  [p0] #col -> GCU_JMP_T

end_row:
  // word 36: print '\n'
  #STDOUT_CHAR -> LSU_ST_A; #'\n' -> LSU_ST_T
  // word 37: cy += 0.125 (raw +2)
  r1 -> ALU_A; #STEP -> ALU_ADD_T
  // word 38: capture cy
  ALU_R -> r1
  // word 39: row++
  r8 -> ALU_A; #1 -> ALU_ADD_T
  // word 40: capture row
  ALU_R -> r8
  // word 41: row < 16 ?
  r8 -> ALU_A; #ROWS -> ALU_LT_T
  // word 42: capture predicate
  ALU_P -> p0
  // word 43: [p0] jump row
  [p0] #row -> GCU_JMP_T

end:
  // word 44: print final '\n'
  #STDOUT_CHAR -> LSU_ST_A; #'\n' -> LSU_ST_T
  // word 45: halt with exit code 0
  #HALT -> LSU_ST_A; #0 -> LSU_ST_T
